#!/usr/bin/env bash
# Stands in for OpenTofu on a CI runner: the runner itself becomes the host,
# set up by the same provision.sh that cloud-init runs on Hetzner.
set -euo pipefail
repo=$(cd "$(dirname "$0")/../.." && pwd)
d=${1#-chdir=}
case $2 in
  init) ;;
  apply)
    id agentbox >/dev/null 2>&1 || sudo useradd -m -s /bin/bash agentbox
    echo 'agentbox ALL=(ALL) NOPASSWD:ALL' | sudo tee /etc/sudoers.d/agentbox >/dev/null
    sudo install -d -m 700 -o agentbox -g agentbox /home/agentbox/.ssh
    sudo install -m 600 -o agentbox -g agentbox "$d/id_ed25519.pub" /home/agentbox/.ssh/authorized_keys
    command -v sshd >/dev/null || sudo apt-get install -y -qq openssh-server >/dev/null
    sudo install -m 600 "$d/ssh_host_ed25519_key" /etc/ssh/ssh_host_ed25519_key
    sudo ssh-keygen -y -f /etc/ssh/ssh_host_ed25519_key | sudo tee /etc/ssh/ssh_host_ed25519_key.pub >/dev/null
    sudo systemctl restart ssh
    sudo sh "$repo/modules/hetzner/provision.sh" >/dev/null
    echo '{}' > "$d/terraform.tfstate"
    basename "$d" >> /tmp/agentbox-test-servers
    ;;
  output)
    if [ "${3:-}" = -json ]; then echo '{"address":{"value":"127.0.0.1"},"ipv4":{"value":"127.0.0.1"}}'; else echo 127.0.0.1; fi
    ;;
esac
