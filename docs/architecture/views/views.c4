views {
  view context {
    title 'System context'
    include developer, agentbox, hetzner, tailscale, github
  }

  view containers of agentbox {
    title 'agentbox: building blocks'
    include *
  }

  dynamic view createHost {
    title 'Create a host on Hetzner, on the developer\'s tailnet or open to the internet'
    developer -> agentbox.cli 'agentbox host create box2 --provider hetzner [--tailnet]'
    agentbox.cli -> agentbox.hostRegistry 'checks no host is named box2'
    agentbox.cli -> agentbox.tailscaleModule 'with --tailnet: tofu apply'
    agentbox.tailscaleModule -> tailscale 'creates a single-use auth key tagged tag:agentbox'
    agentbox.cli -> agentbox.hetznerModule 'tofu apply, with the auth key if there is one'
    agentbox.hetznerModule -> hetzner 'creates server, volume and firewall, which opens no port for a host on the tailnet'
    agentbox.tailscaleModule -> tailscale 'with --tailnet: waits for box2 to join, reads its MagicDNS name'
    agentbox.cli -> agentbox.hostRegistry 'keeps box2\'s state'
    agentbox.cli -> agentbox.sshConfig 'writes box2\'s entry, by its MagicDNS name or its IP address'
    agentbox.cli -> agentbox.agentboxd 'waits until box2 reports healthy'
  }

  dynamic view createSession {
    title 'Create a session and open it once it is set up'
    developer -> agentbox.cli 'agentbox new fix-login acme/workspace --host box2'
    agentbox.cli -> agentbox.sessionRegistry 'checks no session is named fix-login'
    agentbox.cli -> agentbox.agentboxd 'checks box2 runs its version'
    agentbox.cli -> agentbox.agentboxd 'creates fix-login from acme/workspace'
    agentbox.cli -> agentbox.sessionRegistry 'records fix-login on box2'
    agentbox.agentboxd -> github 'clones acme/workspace'
    agentbox.agentboxd -> agentbox.session 'builds fix-login and runs the workspace\'s setup'
    agentbox.session -> github 'clones acme/app'
    agentbox.cli -> agentbox.agentboxd 'waits until fix-login is set up'
    agentbox.cli -> agentbox.session 'opens fix-login'
  }

  deployment view deployment {
    title 'Deployment'
    include devMachine, hetznerCloud, hetznerCloud.server
  }
}
