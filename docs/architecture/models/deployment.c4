deployment {
  node devMachine 'Developer machine' {
    instanceOf agentbox.cli
    instanceOf agentbox.hostRegistry
    instanceOf agentbox.sshConfig
  }
  node hetznerCloud 'Hetzner Cloud' {
    node server 'Host' {
      description 'Server with Docker, created by the Hetzner module; prepared by the CLI with Node and the Dev Container CLI.'
      instanceOf agentbox.session
    }
  }
}
