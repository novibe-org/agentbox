deployment {
  node devMachine 'Developer machine' {
    instanceOf agentbox.cli
    instanceOf agentbox.hostRegistry
    instanceOf agentbox.sessionRegistry
    instanceOf agentbox.sshConfig
  }
  node hetznerCloud 'Hetzner Cloud' {
    node server 'Host' {
      description 'Server with its volume at /var/lib/agentbox and k3s, whose sessions run with the RuntimeClass sysbox-runc; its Kubernetes API answers the host and its pods only, sessions keep their volumes on the server\'s volume through local-path, and the system-upgrade-controller upgrades k3s. A host on the tailnet joins it with tailscaled, whose state is on the volume, and its firewall opens no port.'
      instanceOf agentbox.session
    }
  }
}
