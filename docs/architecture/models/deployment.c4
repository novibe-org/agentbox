deployment {
  node devMachine 'Developer machine' {
    instanceOf agentbox.cli
    instanceOf agentbox.hostRegistry
    instanceOf agentbox.sessionRegistry
    instanceOf agentbox.sshConfig
  }
  node hetznerCloud 'Hetzner Cloud' {
    node server 'Host' {
      description 'Server with the agentbox user, Docker, Node, the Dev Container CLI and its volume at /var/lib/agentbox, set up by the Hetzner module\'s cloud-init, which installs agentboxd of the CLI\'s version from its release and runs it with systemd.'
      instanceOf agentbox.agentboxd
      instanceOf agentbox.session
    }
  }
}
