specification {
  element person
  element system
  element external
  element application
  element library
  element store
  deploymentNode node
}

model {
  developer = person 'Developer' {
    description 'Runs coding agents in agentbox sessions.'
  }

  hetzner = external 'Hetzner Cloud' {
    description 'Cloud provider that runs the host\'s server, volume and firewall.'
  }

  tailscale = external 'Tailscale' {
    description 'Runs the developer\'s tailnet, which a host can join.'
  }

  github = external 'GitHub' {
    description 'Hosts the workspace repo, the repos it clones, and agentbox\'s releases.'
  }

  agentbox = system 'agentbox' {
    description 'Session hosts and one container per coding-agent session.'

    cli = application 'CLI' {
      description 'The agentbox command on the developer\'s machine, one compiled binary per platform.'
      technology 'TypeScript, Commander, Bun; OpenTofu, Dev Container CLI'
    }
    hostRegistry = store 'Host registry' {
      description 'One directory per host under ~/.agentbox/hosts, holding its OpenTofu state.'
      technology 'OpenTofu state, SSH key pair'
    }
    sessionRegistry = store 'Session registry' {
      description 'One file per session under ~/.agentbox/sessions, naming the host it runs on.'
    }
    sshConfig = store 'SSH config' {
      description '~/.ssh/agentbox.conf: every host and the *.agentbox block, included from ~/.ssh/config.'
    }
    hetznerModule = library 'Hetzner module' {
      description 'OpenTofu module for a host on Hetzner: server, volume, firewall and cloud-init.'
      technology 'OpenTofu, hetznercloud/hcloud'
    }
    tailscaleModule = library 'Tailscale module' {
      description 'OpenTofu module for a host on the tailnet: its auth key and its MagicDNS name.'
      technology 'OpenTofu, tailscale/tailscale'
    }
    agentboxd = application 'agentboxd' {
      description 'The session API on each host: creates, lists and deletes the host\'s sessions, and reports the host\'s health.'
      technology 'TypeScript, Bun, HTTP on a Unix socket'
    }
    session = application 'Session' {
      description 'One dev container per session, with its own clone of the workspace repo.'
      technology 'Dev container, sshd'
    }
    feature = library 'Feature' {
      description 'The devcontainer Feature ghcr.io/novibe-org/agentbox/agentbox.'
      technology 'git over HTTPS for GitHub, with the GitHub CLI\'s credential helper'
    }

    cli -> hostRegistry 'keeps each host\'s state in'
    cli -> sessionRegistry 'records each session\'s host in'
    cli -> sshConfig 'writes each host\'s entry to, by its MagicDNS name for a host on the tailnet'
    cli -> hetznerModule 'applies, fetched by its release tag' {
      technology 'OpenTofu'
    }
    cli -> tailscaleModule 'applies for a host on the tailnet, fetched by its release tag' {
      technology 'OpenTofu'
    }
    cli -> hetznerModule 'passes the tailnet auth key to'
    cli -> agentboxd 'replaces with its own version' {
      technology 'SSH and sudo, from the release on GitHub'
    }
    cli -> agentboxd 'creates, lists and deletes sessions with, and waits for a session to be set up' {
      technology 'HTTP over SSH'
    }
    cli -> session 'connects to, through the host' {
      technology 'SSH'
    }
    agentboxd -> session 'builds and sets up, in the background; finds by its label' {
      technology 'Dev Container CLI, Docker'
    }
    session -> feature 'is built with'
  }

  developer -> agentbox.cli 'creates hosts and sessions with'
  agentbox.hetznerModule -> hetzner 'creates the server, volume and firewall on' {
    technology 'Hetzner Cloud API'
  }
  agentbox.tailscaleModule -> tailscale 'creates a single-use auth key tagged tag:agentbox on, and reads the joined host\'s MagicDNS name from' {
    technology 'Tailscale API, an OAuth client from the environment'
  }
  agentbox.agentboxd -> github 'clones the workspace repo from' {
    technology 'HTTPS, the host\'s GitHub login if there is one'
  }
  agentbox.session -> github 'clones the workspace\'s repos from, and pushes to' {
    technology 'HTTPS, the shared GitHub login if there is one'
  }
}
